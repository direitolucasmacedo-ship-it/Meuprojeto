# ---- Telegram ----
# Crie o bot com @BotFather e cole o token aqui
TELEGRAM_BOT_TOKEN=
# @nome_do_canal ou o ID numérico do grupo (ex.: -1001234567890)
TELEGRAM_CHAT_ID=

# ---- Afiliados ----
# Seu ID de associado da Amazon (ex.: meuid-20)
AMAZON_TAG=cacadordecu0e-20
# Parâmetros extras por domínio, em JSON. Ex.:
# {"magazineluiza.com.br": {"partner_id": "123"}}
AFFILIATE_PARAMS={}
# true = só publica ofertas que tenham link de afiliado seu
REQUIRE_AFFILIATE=true

# ---- Fontes ----
# Planilha com ofertas que você mesmo preenche
OFFERS_FILE=ofertas.csv
# Feeds RSS de promoções, separados por vírgula
RSS_FEEDS=

# ---- Execução ----
# true = só imprime no terminal, não publica
DRY_RUN=true
# Intervalo entre buscas (segundos) e máximo de posts por rodada
INTERVAL_SECONDS=900
MAX_POSTS_PER_RUN=5
DB_PATH=promobot.db
